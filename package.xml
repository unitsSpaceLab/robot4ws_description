<?xml version="1.0"?>
<package format="3">
  <name>robot4ws_description</name>
  <version>1.0.0</version>
  <description>The robot4ws_description package - ROS2 Humble version</description>

  <maintainer email="khalid.bourr@gmail.com">Khalid BOURR</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Runtime dependencies for robot description -->
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  
  <!-- For URDF/SDF processing -->
  <exec_depend>urdf</exec_depend>
  <exec_depend>xacro</exec_depend>
  
  <!-- Gazebo Harmonic integration -->
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  
  <!-- For visualization -->
  <exec_depend>rviz2</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
